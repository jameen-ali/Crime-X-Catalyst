APP_ENV=production
APP_PORT=8000

# CORS: Comma-separated list of allowed origins.
# For Zoho Catalyst, set this to your Web Client Hosting URL.
# Example: https://your-project-12345678901.catalystappsail.com
# Or your custom domain if configured.
CORS_ORIGINS=http://localhost:5173

SECRET_KEY=change_me_in_production

# Zoho Catalyst AppSail injects this automatically — do NOT set it manually.
# X_ZOHO_CATALYST_LISTEN_PORT=9000

# Database (future integration)
# POSTGRES_URL=postgresql://user:pass@localhost:5432/crimex
# NEO4J_URL=bolt://localhost:7687
# REDIS_URL=redis://localhost:6379
