{
  "command": "python3 run.py",
  "stack": "python_3_11",
  "build_path": ".",
  "memory": 512,
  "max_instances": 2,
  "env_variables": {
    "APP_ENV": "production",
    "CORS_ORIGINS": "*"
  },
  "ignore": [
    ".env",
    "venv",
    "__pycache__",
    "*.pyc",
    ".pytest_cache",
    "scripts",
    "backend-final.zip"
  ]
}